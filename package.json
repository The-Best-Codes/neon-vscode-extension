{
  "name": "neon-vscode-extension",
  "displayName": "Neon VS Code Extension",
  "description": "Browse and manage your Neon Postgres projects, branches, and databases from VS Code.",
  "version": "0.1.0",
  "publisher": "databricks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neondatabase/neon-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.15.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "authentication": [
      {
        "id": "neon",
        "label": "Neon"
      }
    ],
    "commands": [
      {
        "command": "neon.signIn",
        "title": "Sign In",
        "category": "Neon",
        "icon": "$(sign-in)"
      },
      {
        "command": "neon.signOut",
        "title": "Sign Out",
        "category": "Neon",
        "icon": "$(sign-out)"
      },
      {
        "command": "neon.refresh",
        "title": "Refresh",
        "category": "Neon",
        "icon": "$(refresh)"
      },
      {
        "command": "neon.createProject",
        "title": "Create Project…",
        "category": "Neon",
        "icon": "$(add)"
      },
      {
        "command": "neon.renameProject",
        "title": "Rename Project…",
        "category": "Neon"
      },
      {
        "command": "neon.deleteProject",
        "title": "Delete Project…",
        "category": "Neon"
      },
      {
        "command": "neon.createBranch",
        "title": "Create Branch…",
        "category": "Neon",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "neon.renameBranch",
        "title": "Rename Branch…",
        "category": "Neon"
      },
      {
        "command": "neon.setDefaultBranch",
        "title": "Set as Default Branch",
        "category": "Neon"
      },
      {
        "command": "neon.deleteBranch",
        "title": "Delete Branch…",
        "category": "Neon"
      },
      {
        "command": "neon.copyConnectionString",
        "title": "Copy Connection String",
        "category": "Neon",
        "icon": "$(plug)"
      },
      {
        "command": "neon.startCompute",
        "title": "Start Compute",
        "category": "Neon",
        "icon": "$(debug-start)"
      },
      {
        "command": "neon.suspendCompute",
        "title": "Suspend Compute",
        "category": "Neon",
        "icon": "$(debug-pause)"
      },
      {
        "command": "neon.openInConsole",
        "title": "Open in Neon Console",
        "category": "Neon",
        "icon": "$(link-external)"
      },
      {
        "command": "neon.copyId",
        "title": "Copy ID",
        "category": "Neon"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neon",
          "title": "Neon",
          "icon": "resources/neon.svg"
        }
      ]
    },
    "views": {
      "neon": [
        {
          "icon": "resources/neon.svg",
          "id": "neon.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "neon.projects",
        "contents": "Loading your Neon account…",
        "when": "!neon.ready"
      },
      {
        "view": "neon.projects",
        "contents": "Sign in to browse your Neon projects, branches, and databases.\n[Sign in to Neon](command:neon.signIn)",
        "when": "neon.ready && !neon.signedIn"
      },
      {
        "view": "neon.projects",
        "contents": "You don't have any Neon projects yet.\n[Create Project](command:neon.createProject)",
        "when": "neon.ready && neon.signedIn"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "neon.signIn",
          "when": "view == neon.projects && neon.ready && !neon.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "neon.createProject",
          "when": "view == neon.projects && neon.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "neon.refresh",
          "when": "view == neon.projects && neon.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "neon.signOut",
          "when": "view == neon.projects && neon.signedIn",
          "group": "account@1"
        }
      ],
      "view/item/context": [
        {
          "command": "neon.createProject",
          "when": "view == neon.projects && viewItem == org",
          "group": "inline@1"
        },
        {
          "command": "neon.createProject",
          "when": "view == neon.projects && viewItem == org",
          "group": "1_create@1"
        },
        {
          "command": "neon.copyId",
          "when": "view == neon.projects && viewItem == org",
          "group": "3_copy@1"
        },
        {
          "command": "neon.createBranch",
          "when": "view == neon.projects && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "neon.openInConsole",
          "when": "view == neon.projects && viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "neon.createBranch",
          "when": "view == neon.projects && viewItem == project",
          "group": "1_create@1"
        },
        {
          "command": "neon.openInConsole",
          "when": "view == neon.projects && viewItem == project",
          "group": "2_open@1"
        },
        {
          "command": "neon.copyId",
          "when": "view == neon.projects && viewItem == project",
          "group": "3_copy@1"
        },
        {
          "command": "neon.renameProject",
          "when": "view == neon.projects && viewItem == project",
          "group": "4_edit@1"
        },
        {
          "command": "neon.deleteProject",
          "when": "view == neon.projects && viewItem == project",
          "group": "9_delete@1"
        },
        {
          "command": "neon.copyConnectionString",
          "when": "view == neon.projects && viewItem =~ /^branch/",
          "group": "inline@1"
        },
        {
          "command": "neon.createBranch",
          "when": "view == neon.projects && viewItem =~ /^branch/",
          "group": "inline@2"
        },
        {
          "command": "neon.copyConnectionString",
          "when": "view == neon.projects && viewItem =~ /^branch/",
          "group": "1_copy@1"
        },
        {
          "command": "neon.copyId",
          "when": "view == neon.projects && viewItem =~ /^branch/",
          "group": "1_copy@2"
        },
        {
          "command": "neon.createBranch",
          "when": "view == neon.projects && viewItem =~ /^branch/",
          "group": "2_create@1"
        },
        {
          "command": "neon.openInConsole",
          "when": "view == neon.projects && viewItem =~ /^branch/",
          "group": "3_open@1"
        },
        {
          "command": "neon.renameBranch",
          "when": "view == neon.projects && viewItem =~ /^branch/",
          "group": "4_edit@1"
        },
        {
          "command": "neon.setDefaultBranch",
          "when": "view == neon.projects && viewItem == branch",
          "group": "4_edit@2"
        },
        {
          "command": "neon.deleteBranch",
          "when": "view == neon.projects && viewItem == branch",
          "group": "9_delete@1"
        },
        {
          "command": "neon.startCompute",
          "when": "view == neon.projects && viewItem == endpoint.idle",
          "group": "inline@1"
        },
        {
          "command": "neon.suspendCompute",
          "when": "view == neon.projects && viewItem == endpoint.active",
          "group": "inline@1"
        },
        {
          "command": "neon.startCompute",
          "when": "view == neon.projects && viewItem == endpoint.idle",
          "group": "1_state@1"
        },
        {
          "command": "neon.suspendCompute",
          "when": "view == neon.projects && viewItem == endpoint.active",
          "group": "1_state@1"
        },
        {
          "command": "neon.copyId",
          "when": "view == neon.projects && viewItem =~ /^endpoint/",
          "group": "3_copy@1"
        },
        {
          "command": "neon.copyConnectionString",
          "when": "view == neon.projects && viewItem == database",
          "group": "inline@1"
        },
        {
          "command": "neon.copyConnectionString",
          "when": "view == neon.projects && viewItem == database",
          "group": "1_copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "neon.signIn",
          "when": "neon.ready && !neon.signedIn"
        },
        {
          "command": "neon.signOut",
          "when": "neon.signedIn"
        },
        {
          "command": "neon.refresh",
          "when": "neon.signedIn"
        },
        {
          "command": "neon.createProject",
          "when": "neon.signedIn"
        },
        {
          "command": "neon.createBranch",
          "when": "neon.signedIn"
        },
        {
          "command": "neon.copyConnectionString",
          "when": "neon.signedIn"
        },
        {
          "command": "neon.openInConsole",
          "when": "neon.signedIn"
        },
        {
          "command": "neon.renameProject",
          "when": "false"
        },
        {
          "command": "neon.deleteProject",
          "when": "false"
        },
        {
          "command": "neon.renameBranch",
          "when": "false"
        },
        {
          "command": "neon.setDefaultBranch",
          "when": "false"
        },
        {
          "command": "neon.deleteBranch",
          "when": "false"
        },
        {
          "command": "neon.startCompute",
          "when": "false"
        },
        {
          "command": "neon.suspendCompute",
          "when": "false"
        },
        {
          "command": "neon.copyId",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Neon",
      "properties": {
        "neon.oauth.clientId": {
          "type": "string",
          "default": "neonctl",
          "scope": "application",
          "minLength": 1,
          "description": "Registered public Neon OAuth client. Defaults to neonctl, which is allowed to request the project and organization scopes this extension needs. Sign out before changing this; custom registrations must support dynamic loopback ports."
        },
        "neon.connectionString.pooled": {
          "type": "boolean",
          "default": true,
          "description": "Copy pooled (PgBouncer) connection strings. Turn off for migrations and tools that need a direct connection."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run build",
    "vscode:prepublish": "npm run typecheck && npm run build -- --production",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@neon/sdk": "7.0.1",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
