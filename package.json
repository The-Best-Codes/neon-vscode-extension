{
  "name": "neon-vscode-extension",
  "displayName": "Neon VS Code Extension",
  "description": "Connect your Neon account to Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "databricks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neondatabase/neon-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.15.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
    ],
  "contributes": {
    "authentication": [
      {
        "id": "neon",
        "label": "Neon"
      }
    ],
    "commands": [
      {
        "command": "neon.signIn",
        "title": "Sign In",
        "category": "Neon",
        "icon": "$(sign-in)"
      },
      {
        "command": "neon.signOut",
        "title": "Sign Out",
        "category": "Neon",
        "icon": "$(sign-out)"
      },
      {
        "command": "neon.refreshProfile",
        "title": "Refresh Profile",
        "category": "Neon",
        "icon": "$(refresh)"
      },
      {
        "command": "neon.showProfile",
        "title": "Show Profile",
        "category": "Neon",
        "icon": "$(account)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neon",
          "title": "Neon",
          "icon": "resources/neon.svg"
        }
      ]
    },
    "views": {
      "neon": [
        {
          "icon": "resources/neon.svg",
          "id": "neon.profile",
          "name": "Account"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "neon.profile",
        "contents": "Connect your Neon account to view your profile.\n[Sign in to Neon](command:neon.signIn)",
        "when": "!neon.signedIn"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "neon.signIn",
          "when": "view == neon.profile && !neon.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "neon.refreshProfile",
          "when": "view == neon.profile && neon.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "neon.signOut",
          "when": "view == neon.profile && neon.signedIn",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "neon.signIn",
          "when": "!neon.signedIn"
        },
        {
          "command": "neon.signOut",
          "when": "neon.signedIn"
        },
        {
          "command": "neon.refreshProfile",
          "when": "neon.signedIn"
        }
      ]
    },
    "configuration": {
      "title": "Neon",
      "properties": {
        "neon.oauth.clientId": {
          "type": "string",
          "default": "neonctl",
          "scope": "application",
          "minLength": 1,
          "description": "Registered public Neon OAuth client. The default uses the Neon CLI client for development. Sign out before changing this; production needs a dedicated Neon-approved registration supporting dynamic loopback ports."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run build",
    "vscode:prepublish": "npm run typecheck && npm run build -- --production",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
